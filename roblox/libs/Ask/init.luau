local function hasWord(text, list)
	text = string.lower(text)
	for _, w in list do
		if string.find(text, "%f[%w]" .. w .. "s?%f[%W]") then
			return true
		end
	end
	return false
end

local IMAGE_WORDS = { "image", "picture", "render", "draw", "drawing", "png", "gif", "screenshot", "photo", "animation", "plot", "graph", "chart", "flag", "icon", "logo", "paint" }
local FLAT_WORDS = { "draw", "drawing", "paint", "sketch", "2d", "flag", "icon", "logo", "pixel", "chart", "graph", "plot", "diagram" }
local SOLID_WORDS = { "render", "build", "3d", "part", "brick", "ball", "sphere", "cube", "model", "scene", "snowman", "tower", "house", "building", "car", "tree", "table", "chair", "workspace", "baseplate" }
local SOLID_VERBS = { "render", "build", "3d" }
local CAMERA_WORDS = { "camera", "angle", "view", "perspective", "above", "overhead", "side" }

local function intent(question)
	local flat = hasWord(question, FLAT_WORDS)
	local solid = hasWord(question, SOLID_WORDS) and not string.find(string.lower(question), "%f[%w]part of")
	if solid and (not flat or hasWord(question, SOLID_VERBS)) then
		return "3d"
	elseif flat or hasWord(question, IMAGE_WORDS) then
		return "2d"
	end
	return nil
end

-- renders frame the parts by themselves; a model that moves the camera mostly breaks that
local function dropCameraMoves(code)
	local lines = string.split(code, "\n")
	for i, line in lines do
		if string.find(line, "CurrentCamera", 1, true) and string.find(line, "[^=~<>]=[^=]") then
			lines[i] = "-- " .. line
		end
	end
	return table.concat(lines, "\n")
end

-- Parts this run added that touch nothing (and aren't on the ground), or that sit entirely inside
-- another part. Boxes are world-aligned bounds, which is close enough for the usual scenes.
local function boundsOf(p)
	local cf, half = p.CFrame, p.Size / 2
	local x = math.abs(cf.RightVector.X) * half.X + math.abs(cf.UpVector.X) * half.Y + math.abs(cf.LookVector.X) * half.Z
	local y = math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z
	local z = math.abs(cf.RightVector.Z) * half.X + math.abs(cf.UpVector.Z) * half.Y + math.abs(cf.LookVector.Z) * half.Z
	local e = Vector3.new(x, y, z)
	return cf.Position - e, cf.Position + e
end

local function describePart(p, lo)
	local pos = p.Position
	local function r(n)
		return math.floor(n * 100 + 0.5) / 100
	end
	return `{colorName(p.Color.R, p.Color.G, p.Color.B)} {p.Shape.Name} "{p.Name}" size {r(p.Size.X)}x{r(p.Size.Y)}x{r(p.Size.Z)} at ({r(pos.X)}, {r(pos.Y)}, {r(pos.Z)}), bottom y={r(lo.Y)}`
end

local function checkParts(workspace, before)
	local all, added = {}, {}
	for _, d in workspace:GetDescendants() do
		if d:IsA("BasePart") and not d:IsA("Terrain") and d.Transparency < 1 then
			local lo, hi = boundsOf(d)
			local entry = { part = d, lo = lo, hi = hi }
			table.insert(all, entry)
			if not before[d] then
				table.insert(added, entry)
			end
		end
	end
	if #added == 0 or #added > 300 then
		return nil
	end
	local tol = 0.06
	local floating, hidden = {}, {}
	for _, a in added do
		local touching = a.lo.Y <= tol
		for _, b in all do
			if b ~= a then
				if not touching and a.lo.X <= b.hi.X + tol and a.hi.X >= b.lo.X - tol and a.lo.Y <= b.hi.Y + tol and a.hi.Y >= b.lo.Y - tol and a.lo.Z <= b.hi.Z + tol and a.hi.Z >= b.lo.Z - tol then
					touching = true
				end
				if a.lo.X >= b.lo.X - 0.01 and a.hi.X <= b.hi.X + 0.01 and a.lo.Y >= b.lo.Y - 0.01 and a.hi.Y <= b.hi.Y + 0.01 and a.lo.Z >= b.lo.Z - 0.01 and a.hi.Z <= b.hi.Z + 0.01 and (b.hi - b.lo).Magnitude > (a.hi - a.lo).Magnitude then
					table.insert(hidden, describePart(a.part, a.lo) .. ` (inside the {colorName(b.part.Color.R, b.part.Color.G, b.part.Color.B)} {b.part.Shape.Name})`)
					break
				end
			end
		end
		if not touching then
			table.insert(floating, describePart(a.part, a.lo))
		end
	end
	local lines = {}
	if #floating > 0 then
		table.insert(lines, "Parts that touch nothing (fix their Y if they should rest on something): " .. table.concat(floating, "; ", 1, math.min(5, #floating)))
	end
	if #hidden > 0 then
		table.insert(lines, "Parts hidden inside a bigger part (move them out past its surface): " .. table.concat(hidden, "; ", 1, math.min(5, #hidden)))
	end
	return if #lines > 0 then table.concat(lines, "\n") else nil
end

--// helpers the model's code gets as `scene` and `paint`: relations instead of coordinate math

local SIDES = {
	front = Vector3.new(0, 0, -1),
	back = Vector3.new(0, 0, 1),
	left = Vector3.new(-1, 0, 0),
	right = Vector3.new(1, 0, 0),
	top = Vector3.new(0, 1, 0),
	bottom = Vector3.new(0, -1, 0),
}

local function toVector3(v, what)
	if type(v) == "number" then
		return Vector3.new(v, v, v)
	elseif typeof(v) == "Vector3" then
		return v
	end
	error(`{what} must be a Vector3 or a number`, 3)
end

local function makeTools(env)
	local function newPart(o, fn)
		if type(o) ~= "table" then
			error(`scene.{fn} takes one table, like scene.{fn}\{ size = Vector3.new(2, 2, 2), color = Color3.fromRGB(200, 50, 50) }`, 3)
		end
		local p = env.Instance.new("Part")
		p.Anchored = true
		p.Size = toVector3(o.size or 2, "size")
		if o.color ~= nil then
			if typeof(o.color) ~= "Color3" then
				error("color must be a Color3, like Color3.fromRGB(200, 50, 50)", 3)
			end
			p.Color = o.color
		end
		if o.shape ~= nil then
			local shape = if type(o.shape) == "string" then (Enum.PartType :: any)[o.shape] else o.shape
			p.Shape = shape
		end
		if type(o.name) == "string" then
			p.Name = o.name
		end
		p.Parent = env.workspace
		return p
	end

	local scene = {}

	-- rests a part on top of `on` (or on the ground), centered on it plus `offset`; cylinders stand up
	function scene.place(o)
		local p = newPart(o, "place")
		local isCylinder = p.Shape == Enum.PartType.Cylinder
		local upright = isCylinder and o.upright ~= false
		local height = if upright then p.Size.X else p.Size.Y
		local base, center = 0, Vector3.zero
		if o.on ~= nil then
			local lo, hi = boundsOf(o.on)
			base, center = hi.Y, (lo + hi) / 2
		end
		local offset = if o.offset ~= nil then toVector3(o.offset, "offset") else Vector3.zero
		local cf = CFrame.new(center.X + offset.X, base + (tonumber(o.raise) or 0) + height / 2 + offset.Y, center.Z + offset.Z)
		p.CFrame = if upright then cf * CFrame.Angles(0, 0, math.rad(90)) else cf
		return p
	end

	-- puts a part against one side of `to`, touching it from outside; `offset` moves it along that face
	function scene.attach(o)
		if type(o) ~= "table" or o.to == nil then
			error('scene.attach needs `to` (the part to attach to) and `side` ("front", "back", "left", "right", "top" or "bottom")', 2)
		end
		local normal = SIDES[o.side or "front"]
		if not normal then
			error('side must be "front", "back", "left", "right", "top" or "bottom"', 2)
		end
		local p = newPart(o, "attach")
		local lo, hi = boundsOf(o.to)
		local center, half = (lo + hi) / 2, (hi - lo) / 2
		local rot = CFrame.identity
		local depth
		if p.Shape == Enum.PartType.Cylinder then
			-- a cylinder's length runs along X; point it out of the face
			if normal.Z ~= 0 then
				rot = CFrame.Angles(0, math.rad(90), 0)
			elseif normal.Y ~= 0 then
				rot = CFrame.Angles(0, 0, math.rad(90))
			end
			depth = p.Size.X
		else
			depth = math.abs(normal.X) * p.Size.X + math.abs(normal.Y) * p.Size.Y + math.abs(normal.Z) * p.Size.Z
		end
		local u, v
		if normal.Z ~= 0 then
			u, v = Vector3.xAxis, Vector3.yAxis
		elseif normal.X ~= 0 then
			u, v = Vector3.zAxis, Vector3.yAxis
		else
			u, v = Vector3.xAxis, Vector3.zAxis
		end
		local offset = Vector2.zero
		if o.offset ~= nil then
			if typeof(o.offset) ~= "Vector2" then
				error("attach offset must be a Vector2 (sideways, up) along the face", 2)
			end
			offset = o.offset
		end
		local surface = center + normal * (math.abs(normal.X) * half.X + math.abs(normal.Y) * half.Y + math.abs(normal.Z) * half.Z)
		local pos = surface + normal * (depth / 2) + u * offset.X + v * offset.Y
		p.CFrame = CFrame.new(pos) * rot
		return p
	end

	local paint = {}

	-- vertical gradient filling rows y1..y2
	function paint.gradient(img, y1, y2, topColor, bottomColor)
		local w = img.Size.X
		y1, y2 = math.floor(y1), math.floor(y2)
		for y = y1, y2 do
			local t = if y2 > y1 then (y - y1) / (y2 - y1) else 0
			img:DrawRectangle(Vector2.new(0, y), Vector2.new(w, 1), topColor:Lerp(bottomColor, t))
		end
	end

	-- filled polygon from a list of Vector2 points (triangles, roofs, stars, mountains)
	function paint.polygon(img, points, color)
		if type(points) ~= "table" or #points < 3 then
			error("paint.polygon needs a list of at least 3 Vector2 points", 2)
		end
		local minY, maxY = math.huge, -math.huge
		for _, pt in points do
			minY, maxY = math.min(minY, pt.Y), math.max(maxY, pt.Y)
		end
		for y = math.floor(minY), math.ceil(maxY) do
			local sy = y + 0.5
			local xs = {}
			for i = 1, #points do
				local a, b = points[i], points[i % #points + 1]
				if (a.Y <= sy and b.Y > sy) or (b.Y <= sy and a.Y > sy) then
					table.insert(xs, a.X + (sy - a.Y) / (b.Y - a.Y) * (b.X - a.X))
				end
			end
			table.sort(xs)
			for i = 1, #xs - 1, 2 do
				local x1, x2 = math.floor(xs[i] + 0.5), math.floor(xs[i + 1] + 0.5)
				if x2 > x1 then
					img:DrawRectangle(Vector2.new(x1, y), Vector2.new(x2 - x1, 1), color)
				end
			end
		end
	end

	-- thick arc; degrees counter-clockwise from the right: 0 right, 90 up, 180 left, 270 down
	function paint.arc(img, center, radius, fromDeg, toDeg, thickness, color)
		thickness = math.max(1, thickness or 3)
		local span = math.rad(toDeg - fromDeg)
		local steps = math.max(8, math.ceil(math.abs(span) * radius / (thickness / 3)))
		for i = 0, steps do
			local a = math.rad(fromDeg) + span * i / steps
			img:DrawCircle(Vector2.new(center.X + math.cos(a) * radius, center.Y - math.sin(a) * radius), thickness / 2, color)
		end
	end

	return { scene = scene, paint = paint }
end

local REFUSAL = { "i'm unable", "i am unable", "i can't assist", "i cannot assist", "i can't help", "i cannot help", "i'm sorry, but", "is restricted" }
local function refused(text)
	text = string.lower(text)
	for _, p in REFUSAL do
		if string.find(text, p, 1, true) then
			return true
		end
	end
	return false
end

--// what the user sees: plain-Luau versions of the helpers the code used, so it runs anywhere

local DISPLAY = {
	scene = [[
local scene = {}
local function bounds(p)
	local cf, s = p.CFrame, p.Size / 2
	local function axis(c)
		return math.abs(cf.RightVector[c]) * s.X + math.abs(cf.UpVector[c]) * s.Y + math.abs(cf.LookVector[c]) * s.Z
	end
	local e = Vector3.new(axis("X"), axis("Y"), axis("Z"))
	return cf.Position - e, cf.Position + e
end
local function newPart(o)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = if type(o.size) == "number" then Vector3.one * o.size else o.size or Vector3.one * 2
	if o.color then
		p.Color = o.color
	end
	if o.shape then
		p.Shape = if type(o.shape) == "string" then Enum.PartType[o.shape] else o.shape
	end
	if o.name then
		p.Name = o.name
	end
	p.Parent = workspace
	return p
end]],
	place = [[
-- a part on top of o.on (or the ground), centered on it; cylinders stand up
function scene.place(o)
	local p = newPart(o)
	local upright = p.Shape == Enum.PartType.Cylinder and o.upright ~= false
	local height = if upright then p.Size.X else p.Size.Y
	local base, center = 0, Vector3.zero
	if o.on then
		local lo, hi = bounds(o.on)
		base, center = hi.Y, (lo + hi) / 2
	end
	local off = if type(o.offset) == "number" then Vector3.one * o.offset else o.offset or Vector3.zero
	local cf = CFrame.new(center.X + off.X, base + (o.raise or 0) + height / 2 + off.Y, center.Z + off.Z)
	p.CFrame = if upright then cf * CFrame.Angles(0, 0, math.rad(90)) else cf
	return p
end]],
	attach = [[
-- a part against one side of o.to, touching it from outside
local SIDES = {
	front = Vector3.new(0, 0, -1), back = Vector3.new(0, 0, 1), left = Vector3.new(-1, 0, 0),
	right = Vector3.new(1, 0, 0), top = Vector3.new(0, 1, 0), bottom = Vector3.new(0, -1, 0),
}
function scene.attach(o)
	local p = newPart(o)
	local n = SIDES[o.side or "front"]
	local lo, hi = bounds(o.to)
	local center, half = (lo + hi) / 2, (hi - lo) / 2
	local rot, depth = CFrame.identity, math.abs(n.X) * p.Size.X + math.abs(n.Y) * p.Size.Y + math.abs(n.Z) * p.Size.Z
	if p.Shape == Enum.PartType.Cylinder then
		-- a cylinder's length runs along X; point it out of the face
		rot = if n.Z ~= 0 then CFrame.Angles(0, math.rad(90), 0) elseif n.Y ~= 0 then CFrame.Angles(0, 0, math.rad(90)) else rot
		depth = p.Size.X
	end
	local u = if n.X ~= 0 then Vector3.zAxis else Vector3.xAxis
	local v = if n.Y ~= 0 then Vector3.zAxis else Vector3.yAxis
	local off = o.offset or Vector2.zero
	local surface = center + n * (math.abs(n.X) * half.X + math.abs(n.Y) * half.Y + math.abs(n.Z) * half.Z)
	p.CFrame = CFrame.new(surface + n * (depth / 2) + u * off.X + v * off.Y) * rot
	return p
end]],
	paint = [[
local paint = {}]],
	gradient = [[
function paint.gradient(img, y1, y2, topColor, bottomColor)
	for y = math.floor(y1), math.floor(y2) do
		local t = (y - y1) / math.max(1, y2 - y1)
		img:DrawRectangle(Vector2.new(0, y), Vector2.new(img.Size.X, 1), topColor:Lerp(bottomColor, t))
	end
end]],
	polygon = [[
-- fills the shape row by row between its edge crossings
function paint.polygon(img, points, color)
	local minY, maxY = math.huge, -math.huge
	for _, pt in points do
		minY, maxY = math.min(minY, pt.Y), math.max(maxY, pt.Y)
	end
	for y = math.floor(minY), math.ceil(maxY) do
		local xs, sy = {}, y + 0.5
		for i, a in points do
			local b = points[i % #points + 1]
			if (a.Y <= sy) ~= (b.Y <= sy) then
				table.insert(xs, a.X + (sy - a.Y) / (b.Y - a.Y) * (b.X - a.X))
			end
		end
		table.sort(xs)
		for i = 1, #xs - 1, 2 do
			local x1, x2 = math.floor(xs[i] + 0.5), math.floor(xs[i + 1] + 0.5)
			if x2 > x1 then
				img:DrawRectangle(Vector2.new(x1, y), Vector2.new(x2 - x1, 1), color)
			end
		end
	end
end]],
	arc = [[
-- dots along a circle; degrees go counter-clockwise from the right
function paint.arc(img, center, radius, fromDeg, toDeg, thickness, color)
	thickness = math.max(1, thickness or 3)
	local steps = math.max(8, math.ceil(math.abs(math.rad(toDeg - fromDeg)) * radius / (thickness / 3)))
	for i = 0, steps do
		local a = math.rad(fromDeg + (toDeg - fromDeg) * i / steps)
		img:DrawCircle(Vector2.new(center.X + math.cos(a) * radius, center.Y - math.sin(a) * radius), thickness / 2, color)
	end
end]],
}

-- the helper definitions this code needs that `shown` hasn't had yet, then the code
local function displayCode(code, shown)
	local blocks = {}
	local function need(key, pattern)
		if string.find(code, pattern) and not shown[key] then
			shown[key] = true
			return true
		end
		return false
	end
	local usesScene = string.find(code, "scene%.place") or string.find(code, "scene%.attach")
	if usesScene and not shown.scene then
		shown.scene = true
		table.insert(blocks, DISPLAY.scene)
	end
	if need("place", "scene%.place") then
		table.insert(blocks, DISPLAY.place)
	end
	if need("attach", "scene%.attach") then
		table.insert(blocks, DISPLAY.attach)
	end
	local usesPaint = string.find(code, "paint%.gradient") or string.find(code, "paint%.polygon") or string.find(code, "paint%.arc")
	if usesPaint and not shown.paint then
		shown.paint = true
		table.insert(blocks, DISPLAY.paint)
	end
	for _, name in { "gradient", "polygon", "arc" } do
		if need(name, "paint%." .. name) then
			table.insert(blocks, DISPLAY[name])
		end
	end
	-- io only exists on the bot; guarded, the same code also runs in Studio
	local lines = string.split(code, "\n")
	for i, line in lines do
		local indent, call = string.match(line, "^(%s*)(io%.writeimage%(.*%))%s*$")
		if call then
			lines[i] = `{indent}if io then {call} end`
		end
	end
	code = table.concat(lines, "\n")
	if #blocks == 0 then
		return code
	end
	return "-- helpers\n" .. table.concat(blocks, "\n") .. "\n\n" .. code
end

--// assistant

local AIBot = {}
AIBot.__index = AIBot

function AIBot.new(customLoadstring, customPrint, customRead, env)
	local tools = makeTools(env)
	-- globals for users too (undocumented); the model's code reads its own copy from __askTools
	env.__askTools = tools
	env.scene = tools.scene
	env.paint = tools.paint
	return setmetatable({
		contextToken = "",
		loadstring = customLoadstring or loadstring,
		print = customPrint or print,
		read = customRead,
		env = env,
		tools = tools,
	}, AIBot)
end

function AIBot:_systemPrompt(query, wanted)
	local parts = { BASE, "API index (Luau Runner globals; the normal Roblox API is available too):\n" .. Docs.index }
	local sections = pickSections(query, wanted)
	if #sections > 0 then
		table.insert(parts, "Docs for the functions this task likely needs:\n\n" .. table.concat(sections, "\n\n"))
	end
	return table.concat(parts, "\n\n")
end

function AIBot:_generate(prompt, query, wanted, schema)
	-- a fresh generator per request: the system prompt changes with the docs each step needs
	local generator = Instance.new("TextGenerator")
	generator.SystemPrompt = self:_systemPrompt(query, wanted)
	generator.Temperature = 0.4
	generator.Parent = game:GetService("Lighting")
	local ok, result = pcall(generator.GenerateTextAsync, generator, {
		UserPrompt = prompt,
		ContextToken = self.contextToken,
		JsonSchema = schema or SCHEMA,
		MaxTokens = if schema == SAY_SCHEMA then 300 else 2000,
	})
	generator:Destroy()
	if not ok or type(result) ~= "table" then
		return nil, tostring(result)
	end
	self.contextToken = result.ContextToken or self.contextToken
	local text = string.gsub(result.GeneratedText or "", "^%s*Content generated by artificial intelligence, may make mistakes%.%s*", "")
	local decoded, data = pcall(HttpService.JSONDecode, HttpService, string.match(text, "{.*}") or "")
	if not decoded or type(data) ~= "table" then
		return { plan = "", say = text, question = "", choices = {}, code = "", lookup = {} }
	end
	return {
		plan = if type(data.plan) == "string" then data.plan else "",
		say = if type(data.say) == "string" then data.say else "",
		question = if type(data.question) == "string" then data.question else "",
		choices = if type(data.choices) == "table" then data.choices else {},
		code = if type(data.code) == "string" then data.code else "",
		lookup = if type(data.lookup) == "table" then data.lookup else {},
	}
end

-- Shows the question (and buttons for its choices) and waits for a click or an /input answer.
-- Returns nil if nobody answers in time.
function AIBot:_askUser(question, choices)
	local env = self.env
	local out = self.print
	out("[AI]: " .. question)
	local answer
	local buttons = {}
	local discord = env.discord
	if discord and discord.button then
		for i = 1, math.min(5, #choices) do
			local label = string.sub(tostring(choices[i]), 1, 80)
			if label ~= "" then
				local ok, button = pcall(discord.button, { Label = label, Style = "Secondary" })
				if ok and button then
					button.Clicked:Connect(function()
						answer = answer or label
					end)
					table.insert(buttons, button)
				end
			end
		end
	end
	out(if #buttons > 0 then "(pick a button, or type an answer with /input)" else "(type your answer with /input)")
	local inputs = env.thread.inputs
	local deadline = os.clock() + ANSWER_WAIT
	while not answer and os.clock() < deadline and not env.thread.stopped do
		if inputs and #inputs > 0 then
			answer = env.io.read()
			break
		end
		task.wait(0.2)
	end
	for _, button in buttons do
		pcall(button.Destroy, button)
	end
	if answer then
		out("[USER]: " .. tostring(answer))
	end
	return answer
end

function AIBot:_runCode(code)
	local env = self.env
	local thread = env.thread
	local output = thread.output
	local before = fileState(thread)
	local partsBefore = {}
	pcall(function()
		for _, d in env.workspace:GetDescendants() do
			partsBefore[d] = true
		end
	end)
	env.println("----OUTPUT----")
	local start = #output + 1
	local execute = env._execute or self.loadstring
	-- same first line, so line numbers in errors still match the model's code
	env.__askTools = self.tools
	local fn, compileErr = execute("local scene, paint = __askTools.scene, __askTools.paint; " .. code, "ai")
	local ok, err, where = false, compileErr, nil
	if fn then
		ok, err = xpcall(fn, function(e)
			where = string.match(debug.traceback(), "|ai|:(%d+)")
			return e
		end)
	end
	local described = if ok then nil else describeError(err, where)
	if described then
		env.log("Error: " .. described, "red")
	end
	-- let threads the code spawned finish printing
	local last, quiet, deadline = #output, os.clock(), os.clock() + 4
	while os.clock() < deadline and os.clock() - quiet < 0.5 do
		task.wait(0.1)
		if #output ~= last then
			last, quiet = #output, os.clock()
		end
	end
	local lines = {}
	for i = start, #output do
		table.insert(lines, stripAnsi(output[i]))
	end
	local printed = table.concat(lines)
	if #printed > OUTPUT_LIMIT then
		printed = "..." .. string.sub(printed, -OUTPUT_LIMIT)
	end
	local report = if printed == "" then "(nothing printed)" else printed
	if described then
		report ..= "\nError: " .. described
		-- the model insists on enum items that don't exist (Enum.PartType.Brick); show the real ones
		local enumName = string.match(tostring(err), 'is not a valid member of "Enum%.([%w_]+)"')
		local found, enum = pcall(function()
			return (Enum :: any)[enumName]
		end)
		if enumName and found and enum then
			local names = {}
			for _, item in enum:GetEnumItems() do
				table.insert(names, item.Name)
			end
			report ..= `\nValid Enum.{enumName} items: {table.concat(names, ", ")}. Use only these.`
		end
	end
	local files = newFiles(thread, before)
	local shares, blank = nil, false
	for _, f in files do
		local seen, colors = glance(env.Image, f)
		if seen then
			report ..= "\nImage: " .. seen
			blank = blank or string.find(seen, "almost entirely", 1, true) ~= nil or string.find(seen, "is tiny", 1, true) ~= nil
			shares = shares or colors
		end
	end
	local geometry
	if ok then
		local checked, problems = pcall(checkParts, env.workspace, partsBefore)
		geometry = if checked then problems else nil
		if geometry then
			report ..= "\n" .. geometry
		end
	end
	return {
		ok = ok,
		report = report,
		geometry = geometry,
		printed = printed ~= "",
		wrote = #files > 0,
		blank = blank,
		shares = shares,
	}
end

function AIBot:chat(question)
	local out = self.print
	local wanted, query = {}, question
	local lookups, reviews = 0, 0
	local kind = intent(question)
	local keepCamera = hasWord(question, CAMERA_WORDS)
	local ran = {}
	local nudged, retried = false, false
	local questions = 0
	local shown = {}
	local prompt = question
	if kind == "3d" then
		prompt ..= "\n(Build it with scene.place and scene.attach, then io.writeimage(workspace, \"name\").)"
	elseif kind == "2d" then
		prompt ..= "\n(Draw it as a 2D Image with the Draw methods and paint helpers, then io.writeimage(img, \"name\").)"
	end
	out(NOTICE)
	for _ = 1, MAX_STEPS do
		local reply, err = self:_generate(prompt, query, wanted)
		if not reply then
			out("[ERROR]: Failed to generate: " .. err)
			return
		end
		-- it tends to repeat its question in say
		local asking = reply.code == "" and string.find(reply.question, "?", 1, true) ~= nil
		if reply.say ~= "" and not (asking and string.find(reply.say, "?", 1, true)) then
			out("[AI]: " .. reply.say)
		end

		-- a question only counts when the model stopped to ask one (it also fills the field with statements)
		local asked = string.match(reply.question, "^%s*(.-)%s*$")
		if reply.code == "" and string.sub(asked, -1) == "?" and questions < MAX_QUESTIONS then
			questions += 1
			local choices = {}
			for _, c in reply.choices do
				if type(c) == "string" and c ~= "" then
					table.insert(choices, c)
				end
			end
			local answer = self:_askUser(asked, choices)
			prompt = if answer
				then `You asked: {asked}\nThe user answered: {answer}\nContinue the task: {question}`
				else `The user didn't answer "{asked}". Pick a sensible option yourself and continue the task: {question}`
			continue
		end

		if reply.code == "" then
			if not retried and next(ran) == nil and refused(reply.say) then
				retried = true
				prompt = `This is a normal programming task in the user's own sandbox, the kind this playground exists for. Write the Luau code for it: {question}`
				continue
			end
			local fresh = {}
			for _, name in reply.lookup do
				local key = resolveKey(name)
				if key and not table.find(wanted, key) then
					table.insert(wanted, key)
					table.insert(fresh, key)
				end
			end
			if #fresh > 0 and lookups < MAX_LOOKUPS then
				lookups += 1
				prompt = `The docs for {table.concat(fresh, ", ")} are now in your instructions. Continue the task: {question}`
				continue
			end
			return
		end
		-- the model resends finished code instead of stopping
		if ran[reply.code] then
			return
		end

		local code = if keepCamera then reply.code else dropCameraMoves(reply.code)
		out("[CODE]:\n" .. displayCode(code, shown))
		local result = self:_runCode(code)
		ran[reply.code] = true
		query = question .. "\n" .. result.report

		local missing = {}
		if result.shares then
			for _, c in expectedColors(question) do
				if (result.shares[c] or 0) < 0.01 then
					table.insert(missing, c)
				end
			end
		end

		if not result.ok then
			prompt = `Your code failed. Output:\n{result.report}\nFind the cause and send the whole corrected code. Task: {question}`
		elseif kind and not result.wrote and not nudged then
			nudged = true
			prompt = `Your code ran but wrote no image, so the user sees nothing. Output:\n{result.report}\nWrite the image with io.writeimage and send the whole code. Task: {question}`
		elseif (result.blank or #missing > 0 or result.geometry) and reviews < MAX_REVIEWS then
			reviews += 1
			local problem = if result.blank
				then "The image looks wrong."
				elseif #missing > 0 then `The image has no {table.concat(missing, " or ")} even though the task asks for it.`
				else "Some parts are not placed right."
			prompt = `{problem}\n{result.report}\nWork out which shapes are missing, covered or the wrong color, and send the whole corrected code. Task: {question}`
		elseif result.printed then
			local answer = self:_generate(
				`Your code ran. Output:\n{result.report}\nThe output is correct, even where it differs from what you said earlier. Tell the user what it means for their request in one or two sentences. Request: {question}`,
				query,
				wanted,
				SAY_SCHEMA
			)
			if answer and answer.say ~= "" then
				out("[AI]: " .. answer.say)
			end
			return
		else
			return
		end
	end
	out(`[SYSTEM]: Stopped after {MAX_STEPS} steps.`)
end

function AIBot:reset()
	self.contextToken = ""
end

return AIBot

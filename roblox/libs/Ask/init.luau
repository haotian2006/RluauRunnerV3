local function stem(w)
	for _, suffix in { "ing", "ed", "s" } do
		if #w > #suffix + 3 and string.sub(w, -#suffix) == suffix then
			return string.sub(w, 1, -#suffix - 1)
		end
	end
	return w
end

local function words(text, into)
	into = into or {}
	text = string.gsub(text, "(%l)(%u)", "%1 %2")
	for w in string.gmatch(string.lower(text), "[%a_][%w_]*") do
		if #w >= 3 and not STOP[w] then
			w = stem(w)
			into[w] = (into[w] or 0) + 1
		end
	end
	return into
end

local byKey, lowerKey, indexed = {}, {}, {}
local df = {}
for _, s in Docs.sections do
	byKey[s.key] = s
	lowerKey[string.lower(s.key)] = s.key
	local short = string.match(s.key, "[.:]([%w_]+)$")
	if short and not lowerKey[string.lower(short)] then
		lowerKey[string.lower(short)] = s.key
	end
	local entry = {
		key = s.key,
		name = words(s.key .. " " .. string.gsub(s.key, "%p", "")),
		sig = words(string.match(s.text, "^###%s*([^\n]*)") or ""),
		body = words(s.text),
	}
	for w in entry.body do
		df[w] = (df[w] or 0) + 1
	end
	table.insert(indexed, entry)
end

local function resolveKey(name)
	if type(name) ~= "string" then
		return nil
	end
	name = string.lower(string.gsub(name, "[%s()`]", ""))
	return lowerKey[name] or lowerKey[string.match(name, "[.:]([%w_]+)$") or ""]
end

local function pickSections(query, wanted)
	local picked, seen, used = {}, {}, 0
	local function add(key)
		local s = byKey[key]
		if s and not seen[key] and used + #s.text <= DOC_BUDGET then
			seen[key] = true
			used += #s.text
			table.insert(picked, s.text)
		end
	end
	for _, key in wanted do
		add(key)
	end
	local q = words(query)
	for w in q do
		local hinted = HINTS[w]
		if hinted then
			for _, key in hinted do
				add(key)
			end
		end
	end
	local n = #indexed
	local scored = {}
	for _, e in indexed do
		local score = 0
		for w in q do
			local idf = math.log(1 + n / (df[w] or 1))
			score += idf * ((if e.name[w] then 6 else 0) + (if e.sig[w] then 2 else 0) + math.min(e.body[w] or 0, 3) * 0.5)
		end
		if score >= 3 then
			table.insert(scored, { e.key, score })
		end
	end
	table.sort(scored, function(a, b)
		return a[2] > b[2]
	end)
	for i = 1, math.min(5, #scored) do
		add(scored[i][1])
	end
	return picked
end

--// helpers

local function stripAnsi(text)
	return (string.gsub(string.gsub(text, "\27?%[[%d;]*m", ""), "%[%d+%.%d+%] ", ""))
end

-- `where` is the line of the model's code that was running (from the traceback), so errors
-- raised inside a library still point at the call that caused them
local function describeError(err, where)
	err = tostring(err)
	local source, line, msg = string.match(err, "^(.-):(%d+): (.+)$")
	if not source then
		return if where then `line {where}: {err}` else err
	end
	if string.find(source, "|ai|", 1, true) then
		return `line {line}: {msg}`
	end
	if where then
		return `line {where}: {msg} (raised inside the function your line {where} calls, so check the arguments you pass it)`
	end
	return msg
end

local function fileState(thread)
	local state = {}
	for _, f in thread.files or {} do
		state[f] = f.data
	end
	return state
end

local function newFiles(thread, before)
	local list = {}
	for _, f in thread.files or {} do
		if before[f] ~= f.data then
			table.insert(list, f)
		end
	end
	return list
end

-- by hue, so shading in 3D renders doesn't turn a red part brown
local function colorName(r, g, b)
	local h, s, v = Color3.new(r, g, b):ToHSV()
	if v < 0.15 then
		return "black"
	end
	if s < 0.2 then
		return if v > 0.82 then "white" elseif v < 0.3 then "black" else "gray"
	end
	h *= 360
	if h < 15 or h >= 340 then
		return if s < 0.45 then "pink" else "red"
	elseif h < 45 then
		return if v < 0.6 then "brown" else "orange"
	elseif h < 70 then
		return if v < 0.5 then "brown" else "yellow"
	elseif h < 165 then
		return "green"
	elseif h < 195 then
		return "cyan"
	elseif h < 255 then
		return "blue"
	elseif h < 290 then
		return "purple"
	end
	return "pink"
end

-- What a blind model can learn about an image it wrote: colors, a 3x3 layout and how much of
-- the image isn't background. Returns the text and the share of each color.
local function glance(Image, file)
	local name, data = file.fileType, file.data
	if type(name) ~= "string" or not string.find(string.lower(name), "%.png$") then
		return if type(name) == "string" then `{name} was written.` else nil, nil
	end
	if type(data) == "buffer" then
		data = buffer.tostring(data)
	end
	local ok, img = pcall(Image.fromPng, data)
	if not ok or type(img) ~= "table" or not img.imageBuffer then
		return `{name} was written.`, nil
	end
	local w, h = img.Size.X, img.Size.Y
	local buf = img.imageBuffer
	local steps = 36
	local grid, counts, cells, border = {}, {}, {}, {}
	for sy = 0, steps - 1 do
		for sx = 0, steps - 1 do
			local x, y = math.floor((sx + 0.5) * w / steps), math.floor((sy + 0.5) * h / steps)
			local i = (y * w + x) * 4
			local label = "transparent"
			if buffer.readu8(buf, i + 3) > 25 then
				label = colorName(buffer.readu8(buf, i) / 255, buffer.readu8(buf, i + 1) / 255, buffer.readu8(buf, i + 2) / 255)
			end
			grid[sy * steps + sx] = label
			counts[label] = (counts[label] or 0) + 1
			local cell = math.floor(sy * 3 / steps) * 3 + math.floor(sx * 3 / steps)
			cells[cell] = cells[cell] or {}
			cells[cell][label] = (cells[cell][label] or 0) + 1
			if sx == 0 or sy == 0 or sx == steps - 1 or sy == steps - 1 then
				border[label] = (border[label] or 0) + 1
			end
		end
	end
	local total = steps * steps
	local function top(map)
		local best, n = nil, -1
		for label, c in map do
			if c > n then
				best, n = label, c
			end
		end
		return best, n
	end
	local shares, list = {}, {}
	for label, n in counts do
		shares[label] = n / total
		table.insert(list, label)
	end
	table.sort(list, function(a, b)
		return shares[a] > shares[b]
	end)
	local parts = {}
	for i = 1, math.min(5, #list) do
		if shares[list[i]] >= 0.02 then
			table.insert(parts, `{list[i]} {math.floor(shares[list[i]] * 100 + 0.5)}%`)
		end
	end
	local rows = {}
	for r = 0, 2 do
		local row = {}
		for c = 0, 2 do
			table.insert(row, (top(cells[r * 3 + c] or {})) or "?")
		end
		table.insert(rows, table.concat(row, " "))
	end
	local background = top(border)
	local subject = 1 - (shares[background] or 0)
	local text = `{name} ({w}x{h}). Colors: {table.concat(parts, ", ")}. Layout, 3x3 from the top row: {table.concat(rows, " / ")}. Background {background}; everything else covers {math.floor(subject * 100 + 0.5)}%.`
	if shares[list[1]] >= 0.97 then
		text ..= ` It is almost entirely {list[1]}, so what you meant to draw is missing, off the image, covered, or the same color as the background.`
	elseif subject < 0.03 then
		text ..= " The subject is tiny."
	end
	return text, shares
end


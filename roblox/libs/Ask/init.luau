-- colors the task names, by the request's own words
local function expectedColors(text)
	local out = {}
	for w in string.gmatch(string.lower(text), "%a+") do
		local c = COLOR_WORDS[w]
		if c and not table.find(out, c) then
			table.insert(out, c)
		end

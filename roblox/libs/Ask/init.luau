-- 3D: a table with a vase, and a snowball with eyes
local wood = Color3.fromRGB(150, 100, 60)
local top = scene.place{ size = Vector3.new(6, 0.4, 3), color = wood, raise = 3, name = "TableTop" }
for _, x in { -2.7, 2.7 } do
	for _, z in { -1.2, 1.2 } do
		scene.attach{ to = top, side = "bottom", size = Vector3.new(0.3, 3, 0.3), color = wood, offset = Vector2.new(x, z) }
	end
end
scene.place{ on = top, size = Vector3.new(1.5, 0.8, 0.8), shape = "Cylinder", color = Color3.fromRGB(70, 120, 200), name = "Vase" }
